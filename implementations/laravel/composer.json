{
    "name": "waysnx/business-framework-laravel",
    "description": "WaysNX Business Framework - Laravel Implementation",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "WaysNX",
            "homepage": "https://waysnx.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "ramsey/uuid": "^4.7",
        "illuminate/support": "^13.0",
        "illuminate/container": "^13.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.8"
    },
    "autoload": {
        "psr-4": {
            "WaysNX\\BusinessFramework\\": "src/",
            "WaysNX\\BusinessFramework\\Types\\": "../../packages/types/",
            "WaysNX\\BusinessFramework\\Core\\": "../../packages/core/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WaysNX\\BusinessFramework\\Tests\\": "tests/",
            "WaysNX\\BusinessFramework\\Core\\Tests\\": "../../packages/core/tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html=coverage",
        "lint": "phpcs --standard=PSR12 src tests",
        "lint:fix": "phpcbf --standard=PSR12 src tests"
    },
    "extra": {
        "laravel": {
            "providers": [
                "WaysNX\\BusinessFramework\\ServiceProvider\\LaravelServiceProvider"
            ]
        }
    },
    "suggest": {
        "squizlabs/php_codesniffer": "For code quality checks"
    }
}
